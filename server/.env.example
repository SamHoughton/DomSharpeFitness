DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=your-secret-key-at-least-32-characters-long

# One-time secret required by POST /api/auth/setup-dom to create the admin account
SETUP_SECRET=change-me-then-delete-after-setup

# Lead notification emails (Resend). If unset, enquiries are still saved to the
# database but no email is sent. Set these in production.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Sharpe Strength <hello@yourdomain.com>
DOM_EMAIL=sharp.strength1@gmail.com

ALLOWED_ORIGINS=https://domsharpefitness.netlify.app
